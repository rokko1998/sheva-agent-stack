#!/bin/sh
set -eu
GRAPHIFY_PYTHON="$HOME/.local/share/uv/tools/graphifyy/bin/python3"
if [ ! -x "$GRAPHIFY_PYTHON" ]; then
    echo "Architecture review failed: active Graphify Python is missing: $GRAPHIFY_PYTHON" >&2
    exit 1
fi
exec "$GRAPHIFY_PYTHON" "$(dirname "$0")/architecture_review.py" "$@"
