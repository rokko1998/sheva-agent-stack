#!/bin/bash
set -u

ROOT="$HOME/.local/share/agent-skill-sources/github"
AGENT_STACK="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GRAPHIFY_REPO="$ROOT/Graphify-Labs/graphify"
KNOWLEDGE_STACK="${SHEVA_KNOWLEDGE_STACK_REPO:-/Users/sheva/Documents/Projects/sheva-knowledge-stack}"
STATE="${SHEVA_AGENT_SKILL_UPDATER_STATE:-$HOME/.local/state/agent-skill-updater}"
REPORTS="$STATE/reports"

LAST_CHECK="$STATE/last-check"
PENDING="$STATE/pending"
LOCK="$STATE/update-lock"

INTERVAL=$((7 * 24 * 60 * 60))

mkdir -p "$REPORTS"

force=0
if [ "${1:-}" = "--force" ]; then
    force=1
fi

now=$(date +%s)

# Если есть необработанные обновления — просто сообщаем об этом.
if [ -s "$PENDING" ]; then
    printf '%s\n' \
      "Pending GitHub skill updates exist." \
      "Before normal work, read and follow:" \
      "$HOME/.agents/skills/skill-update-summary/SKILL.md" \
      "Then process the pending reports listed in:" \
      "$PENDING"
fi

# Не проверяем GitHub чаще раза в неделю,
# если только явно не передан --force.
if [ "$force" -eq 0 ] && [ -f "$LAST_CHECK" ]; then
    last=$(stat -f %m "$LAST_CHECK" 2>/dev/null || echo 0)

    if [ $((now - last)) -lt "$INTERVAL" ]; then
        exit 0
    fi
fi

# Не даём двум сессиям одновременно обновлять одни и те же репозитории.
if ! mkdir "$LOCK" 2>/dev/null; then
    exit 0
fi

trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT

# Повторная проверка после взятия lock.
if [ "$force" -eq 0 ] && [ -f "$LAST_CHECK" ]; then
    last=$(stat -f %m "$LAST_CHECK" 2>/dev/null || echo 0)

    if [ $((now - last)) -lt "$INTERVAL" ]; then
        exit 0
    fi
fi

export GIT_TERMINAL_PROMPT=0

stamp=$(date '+%Y%m%d-%H%M%S')
report="$REPORTS/$stamp.md"

changed=0
check_ok=1

{
    echo "# Agent skill source update"
    echo
    echo "Checked: $(date)"
    echo
} > "$report"

while IFS= read -r gitdir; do
    repo="${gitdir%/.git}"

    before=$(git -C "$repo" rev-parse HEAD 2>/dev/null) || continue

    # Source repos считаем read-only.
    if [ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ]; then
        {
            echo "## SKIPPED: $repo"
            echo
            echo "Reason: dirty worktree."
            echo
        } >> "$report"
        if [ "$repo" = "$GRAPHIFY_REPO" ]; then changed=1; fi
        continue
    fi

    if ! git -C "$repo" fetch --prune --quiet; then
        {
            echo "## FETCH FAILED: $repo"
            echo
        } >> "$report"

        check_ok=0
        continue
    fi

    upstream=$(git -C "$repo" rev-parse \
        --abbrev-ref \
        --symbolic-full-name '@{u}' \
        2>/dev/null || true)

    if [ -z "$upstream" ]; then
        {
            echo "## SKIPPED: $repo"
            echo
            echo "Reason: no upstream branch."
            echo
        } >> "$report"
        continue
    fi

    ahead=$(git -C "$repo" rev-list --count "$upstream..HEAD" 2>/dev/null || echo 0)
    behind=$(git -C "$repo" rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)

    # Никогда автоматически не переписываем локальную историю.
    if [ "$ahead" -ne 0 ]; then
        {
            echo "## SKIPPED: $repo"
            echo
            echo "Reason: local branch contains commits not present upstream."
            echo
        } >> "$report"
        if [ "$repo" = "$GRAPHIFY_REPO" ]; then changed=1; fi
        continue
    fi

    if [ "$behind" -eq 0 ]; then
        continue
    fi

    if ! git -C "$repo" merge --ff-only "$upstream" --quiet; then
        {
            echo "## UPDATE FAILED: $repo"
            echo
        } >> "$report"

        check_ok=0
        continue
    fi

    after=$(git -C "$repo" rev-parse HEAD)

    changed=1

    {
        echo "## UPDATED: $repo"
        echo
        echo "Before: $before"
        echo "After:  $after"
        echo

        echo "### Commits"
        git -C "$repo" log \
            --no-merges \
            --pretty='- %h %s' \
            "$before..$after"

        echo
        echo "### Changed files"
        git -C "$repo" diff \
            --name-status \
            "$before..$after"

        echo
    } >> "$report"

done < <(
    find "$ROOT" -type d -name .git -prune -print 2>/dev/null
)

# DataWeave is pinned by the knowledge application, not fast-forwarded here.
if [ -f "$KNOWLEDGE_STACK/knowledge_stack/__main__.py" ]; then
    if dependency_json=$(cd "$KNOWLEDGE_STACK" && python3 -m knowledge_stack check-updates 2>/dev/null); then
        if [ "$(printf '%s' "$dependency_json" | python3 -c 'import json,sys; print(int(json.load(sys.stdin)["update_available"]))')" -eq 1 ]; then
            changed=1
            {
                echo "## AVAILABLE: ObsidianDataWeave"
                echo
                printf '%s' "$dependency_json" | python3 -c 'import json,sys; x=json.load(sys.stdin); print("Active: " + x["active"]); print("Latest: " + x["available"]); print("Promoted: no")'
                echo
            } >> "$report"
        fi
    else
        check_ok=0
        {
            echo "## CHECK FAILED: ObsidianDataWeave"
            echo
        } >> "$report"
    fi
fi

# Graphify source may fast-forward above; CLI, MCP and skill stay on one active
# uv-tool build until activate-graphify promotes that source revision.
if [ -d "$GRAPHIFY_REPO/.git" ]; then
    if graphify_json=$(python3 "$AGENT_STACK/scripts/activate-graphify" --status 2>/dev/null); then
        graphify_flags=$(printf '%s' "$graphify_json" | python3 -c 'import json,sys; x=json.load(sys.stdin); print(int(x["update_available"]), int(x["runtime_drift"]), int(x["source_dirty"]), int(x["source_ahead"]), int(any(p.get("refresh_recommended") for p in x.get("projects", []))))')
        read -r graphify_available graphify_drift graphify_dirty graphify_ahead graphify_project_drift <<< "$graphify_flags"
        if [ "$graphify_available" -eq 1 ] && [ "$graphify_dirty" -eq 0 ] && [ "$graphify_ahead" -eq 0 ]; then
            changed=1
            {
                echo "## AVAILABLE: Graphify"
                echo
                printf '%s' "$graphify_json" | python3 -c 'import json,sys; x=json.load(sys.stdin); print("Active: " + x["active_commit"] + " (" + x["active_version"] + ")"); print("Latest source: " + x["source_commit"] + " (" + x["source_version"] + ")"); print("CLI/MCP/skill promoted: no")'
                echo "Promote together: $AGENT_STACK/scripts/activate-graphify"
                echo
                echo "### Commits since active runtime"
                active_commit=$(printf '%s' "$graphify_json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["active_commit"])')
                git -C "$GRAPHIFY_REPO" log --no-merges --pretty='- %h %s' "$active_commit..HEAD" || true
                echo
                echo "### Changed files since active runtime"
                git -C "$GRAPHIFY_REPO" diff --name-status "$active_commit..HEAD" || true
                echo
            } >> "$report"
        fi
        if [ "$graphify_drift" -eq 1 ] || [ "$graphify_dirty" -eq 1 ] || [ "$graphify_ahead" -eq 1 ]; then
            changed=1
            {
                echo "## ATTENTION: Graphify"
                echo
                printf '%s' "$graphify_json" | python3 -c 'import json,sys; x=json.load(sys.stdin); print("Source dirty: " + str(x["source_dirty"])); print("Source ahead: " + str(x["source_ahead"])); print("Runtime drift: " + str(x["runtime_drift"])); [print("- " + p) for p in x["problems"]]'
                echo "Review before running $AGENT_STACK/scripts/activate-graphify"
                echo
            } >> "$report"
        fi
        if [ "$graphify_project_drift" -eq 1 ]; then
            changed=1
            {
                echo "## ATTENTION: Graphify project integration"
                echo
                printf '%s' "$graphify_json" | python3 -c 'import json,sys; x=json.load(sys.stdin); [print("- " + p["project"] + ": rules/hooks stale or missing; refresh: " + str(p.get("error") or "scripts/graphify-project refresh-project " + p["project"])) for p in x.get("projects", []) if p.get("refresh_recommended")]'
                echo
            } >> "$report"
        fi
    else
        check_ok=0
        {
            echo "## CHECK FAILED: Graphify activation status"
            echo
        } >> "$report"
    fi
fi

# Только успешная проверка считается недельной проверкой.
if [ "$check_ok" -eq 1 ]; then
    touch "$LAST_CHECK"
fi

if [ "$changed" -eq 1 ]; then
    echo "$report" >> "$PENDING"

    echo
    echo "GitHub source changes were applied or are available for review."
    echo "Report: $report"
    echo
    echo "Before normal work, read and follow:"
    echo "$HOME/.agents/skills/skill-update-summary/SKILL.md"
    echo "Then process the pending reports listed in:"
    echo "$PENDING"

else
    # Если обновлений не было и ошибок тоже не было — report не нужен.
    if [ "$check_ok" -eq 1 ]; then
        rm -f "$report"
    fi
fi

exit 0
